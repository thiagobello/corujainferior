# Copie para .env.backup.local (não vai para o git) e troque SUA_SENHA.
# Supabase › botão "Connect" › Session pooler (porta 5432).
# Senha: a do banco (Project Settings › Database › Reset database password).
SUPABASE_DB_URL=postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# Opcional: pasta dos backups (padrão: ~/Backups/coruja)
# BACKUP_DIR=$HOME/Backups/coruja

# Só para ./scripts/recomprimir-fotos.sh --enviar (regrava as fotos antigas no bucket).
# Supabase › Project Settings › API Keys › service_role. Nunca coloque no app.
# SUPABASE_SERVICE_ROLE_KEY=
